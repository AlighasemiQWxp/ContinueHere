import { ScrollView, Palette } from "std-widgets.slint";
import { Title, Label } from "components.slint";
import { TooltipSystem } from "tooltip.slint";

import { NavigationBar, NavigationItem, SnackBar, MaterialPalette } from "@material";
import { AppTheme } from "theme.slint";
import { MenuItem } from "@material";
export { MenuItem } from "@material";

import { DeviceRow, ContentRow } from "models.slint";
export { DeviceRow, ContentRow } from "models.slint";
import { ReceivePage } from "pages/receive.slint";
import { SendPage } from "pages/send.slint";
import { OutgoingTransfers } from "pages/transfers.slint";
import { RecentActivity } from "pages/activity.slint";
import { HistoryPage } from "pages/history.slint";
import { SettingsPage } from "pages/settings.slint";
import { PreviewDialog } from "dialogs/preview.slint";
import { ReconnectDialog } from "dialogs/reconnect.slint";
import { ErrorDialog } from "dialogs/error.slint";
import { DocumentDialog } from "dialogs/document.slint";

export component MainWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; root.apply-theme(); }
    icon: @image-url("../assets/ContinueHere.png");
    title: "ContinueHere";
    preferred-width: 1080px;
    preferred-height: 760px;
    min-width: 360px;
    min-height: 360px;
    background: AppTheme.backdrop;
    in-out property <int> page: 1;
    in property <bool> rtl: false;
    in-out property <string> error-message;
    in-out property <int> active-transition;
    in property <string> local-device-name;
    in property <string> local-device-detail;
    in property <bool> discovery-active: false;
    in property <[DeviceRow]> nearby-devices;
    in property <[DeviceRow]> trusted-devices;
    in-out property <string> display-name;
    in-out property <string> default-directory;
    in-out property <int> selected-language: 0;

    in property <string> devices-text: "Receive";
    in property <string> settings-text: "Settings";
    in property <string> this-device-text: "This device";
    in property <string> nearby-devices-text: "Nearby devices";
    in property <string> trusted-devices-text: "Trusted devices";
    in property <string> no-nearby-devices-text: "No nearby devices found.";
    in property <string> no-trusted-devices-text: "No trusted devices yet.";
    in property <string> manual-endpoint-text: "Manual endpoint (host:port)";
    in property <string> add-text: "Add";
    in property <string> active-text: "Discovery active";
    in property <string> inactive-text: "Discovery unavailable";
    in property <string> connected-text: "Connected";
    in property <string> disconnected-text: "Disconnected";
    in property <string> device-name-text: "Device name";
    in property <string> language-text: "Language";
    in property <string> english-text: "English";
    in property <string> persian-text: "Persian";
    in property <string> save-text: "Save";
    in property <string> dismiss-text: "Dismiss";

    callback add-manual-endpoint(string);
    callback save-display-name(string);
    callback select-language(int);
    callback refresh-devices-requested();
    callback refresh-settings-requested();
    callback refresh-presentation-requested();


    in property <bool> ready;
    in-out property <string> destination-device;
    in property <[string]> connected-device-names;
    in property <[MenuItem]> connected-device-menu;
    in property <[string]> connected-device-ids;
    in-out property <int> destination-index: -1;
    in property <bool> connection-busy;
    in property <string> transport-endpoint;
    in property <bool> network-available;
    in property <bool> pairing-active;
    in property <bool> pairing-verifiable;
    in property <string> pairing-status;
    in property <string> pairing-code;
    in property <string> pairing-endpoint;
    in-out property <bool> devices-unread;
    in-out property <bool> send-unread;
    in-out property <bool> history-unread;
    in property <[ContentRow]> incoming-transfers;
    in property <[ContentRow]> outgoing-transfers;
    in property <[ContentRow]> history-devices;
    in property <[ContentRow]> history-entries;
    in property <[ContentRow]> recent-history;
    in-out property <string> history-device;
    in property <string> history-device-name;
    in property <string> history-error;
    in-out property <float> content-opacity: 1;
    in-out property <bool> reduce-motion: false;
    in property <bool> preview-visible;
    in property <bool> preview-video;
    in property <bool> preview-playing;
    in property <image> preview-image;
    in property <string> preview-title;
    in property <string> preview-error;
    in property <int> preview-generation;
    in property <float> preview-position;
    in property <float> preview-duration;
    in property <string> preview-time;
    in property <int> image-frame-delay;
    in-out property <float> preview-volume: 1;
    in-out property <float> preview-zoom: 1;
    in-out property <string> playback-position-input;
    in property <string> document-title;
    in property <string> document-device-name;
    in property <string> document-kind;
    in-out property <string> document-position-input;
    property <bool> compact: root.width < 900px;
    property <length> nav-width: 104px;
    property <string> close-text: rtl ? "بستن" : "Close";
    property <string> open-text: rtl ? "باز کردن" : "Open";
    property <string> remove-text: rtl ? "حذف" : "Remove";
    property <string> cancel-text: rtl ? "لغو" : "Cancel";
    property <string> accept-text: rtl ? "پذیرش" : "Accept";
    property <string> reject-text: rtl ? "رد کردن" : "Reject";
    property <string> choose-folder-text: rtl ? "انتخاب پوشه" : "Choose folder";
    property <string> retry-text: rtl ? "تلاش دوباره" : "Retry";

    callback page-selected(int);
    callback startup-completed();
    callback device-action(string, string, string);
    callback poll-connection-requested();
    callback pairing-action(string, string);
    callback content-selection-completed(int);
    callback send-handoff(string, string, string, string);
    callback send-file(string, string);
    callback choose-document(string, string);
    callback document-action(string, string);
    callback transfer-action(string, string);
    callback history-action(string, string);
    in-out property <int> theme-style: 3;
    in-out property <float> brightness: 100;
    in property <string> local-addresses;
    in-out property <string> reconnect-device;
    in-out property <string> reconnect-endpoint;
    in property <string> preview-path;
    in property <[ContentRow]> sent-activities;
    in property <[ContentRow]> received-activities;
    callback choose-directory();
    callback select-theme(int);
    callback save-brightness(float);
    callback refresh-network();
    callback reconnect-requested(string);
    callback show-notice(string);
    property <string> notice-text;
    show-notice(message) => { root.notice-text = message; notice.show(); notice-timer.restart(); }
    notice := SnackBar { width: root.width; height: root.height; text: root.notice-text; has-close-button: true; }
    notice-timer := Timer { interval: 4s; running: false; triggered => { notice.close(); self.running = false; } }
    changed theme-style => { root.apply-theme(); }
    function apply-theme() {
        AppTheme.style = root.theme-style;
        MaterialPalette.schemes = { light: AppTheme.scheme, dark: AppTheme.scheme };
    }
    property <[int]> navigation-pages: [1, 0, 3, 4];
    property <int> navigation-index: root.page == 1 ? 0 : root.page == 0 ? 1 : root.page == 3 ? 2 : 3;
    property <[NavigationItem]> navigation-items: [
        { text: root.rtl ? "ارسال" : "Send", icon: @image-url("../assets/send.svg"), show-badge: root.send-unread, badge: root.send-unread ? "●" : "" },
        { text: root.devices-text, icon: @image-url("../assets/receive.svg"), show-badge: root.devices-unread, badge: root.devices-unread ? "●" : "" },
        { text: root.rtl ? "تاریخچه" : "History", icon: @image-url("../assets/history.svg"), show-badge: root.history-unread, badge: root.history-unread ? "●" : "" },
        { text: root.settings-text, icon: @image-url("../assets/settings.svg") }
    ];
    callback preview-action(string, float);
    callback show-error-requested(string);
    callback dismiss-error-requested();
    callback close-reconnect-requested();
    callback next-image-frame();
    callback refresh-pairing-requested();
    callback refresh-handoffs-requested();
    callback refresh-transfers-requested();
    callback refresh-history-requested();

    Rectangle {
        width: root.width;
        height: root.height;
        background: AppTheme.backdrop;
    }
    if !root.compact: Rectangle {
        x: root.rtl ? root.width - root.nav-width : 0px;
        width: root.nav-width; height: root.height;
        background: AppTheme.sidebar;
        border-color: MaterialPalette.outline-variant;
        border-width: 0px;
        VerticalLayout {
            padding-top: 12px; padding-bottom: 12px; spacing: 8px; alignment: center;
            TooltipSystem {
                icon: @image-url("../assets/send.svg");
                label: root.rtl ? "ارسال" : "Send";
                selected: root.page == 1; vertical-navigation: true; rtl: root.rtl;
                show-label: true; min-height: 64px;
                show-badge: root.send-unread;
                fill-row: true;
                clicked => { if root.ready && !root.preview-visible { root.page-selected(1); } }
            }
            TooltipSystem {
                icon: @image-url("../assets/receive.svg");
                label: root.devices-text;
                selected: root.page == 0; vertical-navigation: true; rtl: root.rtl;
                show-label: true; min-height: 64px;
                show-badge: root.devices-unread;
                fill-row: true;
                clicked => { if root.ready && !root.preview-visible { root.page-selected(0); } }
            }
            TooltipSystem {
                icon: @image-url("../assets/history.svg");
                label: root.rtl ? "تاریخچه" : "History";
                selected: root.page == 3; vertical-navigation: true; rtl: root.rtl;
                show-label: true; min-height: 64px;
                show-badge: root.history-unread;
                fill-row: true;
                clicked => { if root.ready && !root.preview-visible { root.page-selected(3); } }
            }
            Rectangle { vertical-stretch: 1; }
            TooltipSystem {
                icon: @image-url("../assets/settings.svg");
                label: root.settings-text;
                selected: root.page == 4; vertical-navigation: true; rtl: root.rtl;
                show-label: true; min-height: 64px;
                fill-row: true;
                clicked => { if root.ready && !root.preview-visible { root.page-selected(4); } }
            }
            Rectangle { height: 8px; }
        }
    }
    if root.compact: NavigationBar {
        z: 20;
        y: root.height - self.height; width: root.width; height: 80px;
        items: root.rtl ? [root.navigation-items[3], root.navigation-items[2], root.navigation-items[1], root.navigation-items[0]] : root.navigation-items;
        current-index: root.rtl ? 3 - root.navigation-index : root.navigation-index;
        index-changed(index) => { if root.ready && !root.preview-visible { root.page-selected(root.navigation-pages[root.rtl ? 3 - index : index]); } }
    }
    content := Rectangle {
        z: 10;
        x: root.compact || root.rtl ? 0px : root.nav-width;
        width: root.compact ? root.width : root.width - root.nav-width;
        height: root.compact ? root.height - 80px : root.height;
        opacity: root.reduce-motion ? 1 : root.content-opacity;
        animate opacity { duration: root.reduce-motion ? 0ms : 220ms; easing: ease-out; }
        ScrollView {
            width: parent.width; height: parent.height;
            viewport-width: self.width;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                width: parent.width;
                padding: root.compact ? 14px : 24px; spacing: 14px; alignment: start;
                if root.page == 0: ReceivePage {
                    devices-text: root.devices-text;
                    rtl: root.rtl;
                    local-device-name: root.local-device-name;
                    local-device-detail: root.local-device-detail;
                    pairing-status: root.pairing-status;
                    pairing-code: root.pairing-code;
                    ready: root.ready;
                    preview-visible: root.preview-visible;
                    pairing-active: root.pairing-active;
                    pairing-verifiable: root.pairing-verifiable;
                    pairing-action(value0, value1) => { root.pairing-action(value0, value1); }
                    reject-text: root.reject-text;
                    cancel-text: root.cancel-text;
                    local-addresses: root.local-addresses;
                    pairing-endpoint: root.pairing-endpoint;
                    transport-endpoint: root.transport-endpoint;
                    network-available: root.network-available;
                    default-directory: root.default-directory;
                    refresh-network() => { root.refresh-network(); }
                }
                if root.page == 1: SendPage {
                    rtl: root.rtl;
                    connected-device-menu: root.connected-device-menu;
                    destination-index <=> root.destination-index;
                    connected-device-names: root.connected-device-names;
                    ready: root.ready;
                    preview-visible: root.preview-visible;
                    destination-device <=> root.destination-device;
                    connected-device-ids: root.connected-device-ids;
                    send-file(value0, value1) => { root.send-file(value0, value1); }
                    choose-document(value0, value1) => { root.choose-document(value0, value1); }
                    playback-position-input <=> root.playback-position-input;
                    send-handoff(value0, value1, value2, value3) => { root.send-handoff(value0, value1, value2, value3); }
                    pairing-active: root.pairing-active;
                    pairing-status: root.pairing-status;
                    pairing-code: root.pairing-code;
                    pairing-verifiable: root.pairing-verifiable;
                    pairing-action(value0, value1) => { root.pairing-action(value0, value1); }
                    reject-text: root.reject-text;
                    cancel-text: root.cancel-text;
                    nearby-devices-text: root.nearby-devices-text;
                    discovery-active: root.discovery-active;
                    nearby-devices: root.nearby-devices;
                    trusted-devices: root.trusted-devices;
                    connected-text: root.connected-text;
                    disconnected-text: root.disconnected-text;
                    connection-busy: root.connection-busy;
                    device-action(value0, value1, value2) => { root.device-action(value0, value1, value2); }
                    reconnect-requested(value) => { root.reconnect-requested(value); }
                    add-manual-endpoint(value0) => { root.add-manual-endpoint(value0); }
                }
                if root.page == 1 && root.outgoing-transfers.length > 0: OutgoingTransfers {
                    rtl: root.rtl;
                    outgoing-transfers: root.outgoing-transfers;
                    ready: root.ready;
                    preview-visible: root.preview-visible;
                    accept-text: root.accept-text;
                    transfer-action(value0, value1) => { root.transfer-action(value0, value1); }
                    choose-folder-text: root.choose-folder-text;
                    reject-text: root.reject-text;
                    open-text: root.open-text;
                    cancel-text: root.cancel-text;
                    remove-text: root.remove-text;
                }
                if root.page == 0 || (root.page == 1 && root.sent-activities.length > 0): RecentActivity {
                    rtl: root.rtl;
                    page <=> root.page;
                    incoming-transfers: root.incoming-transfers;
                    received-activities: root.received-activities;
                    ready: root.ready;
                    preview-visible: root.preview-visible;
                    accept-text: root.accept-text;
                    transfer-action(value0, value1) => { root.transfer-action(value0, value1); }
                    choose-folder-text: root.choose-folder-text;
                    reject-text: root.reject-text;
                    cancel-text: root.cancel-text;
                    sent-activities: root.sent-activities;
                    default-directory: root.default-directory;
                    connection-busy: root.connection-busy;
                    reconnect-requested(value) => { root.reconnect-requested(value); }
                    show-history() => { root.page-selected(3); }
                    history-action(value0, value1) => { root.history-action(value0, value1); }
                }
                if root.page == 3: HistoryPage {
                    rtl: root.rtl;
                    history-error: root.history-error;
                    history-device <=> root.history-device;
                    history-devices: root.history-devices;
                    recent-history: root.recent-history;
                    ready: root.ready;
                    preview-visible: root.preview-visible;
                    history-action(value0, value1) => { root.history-action(value0, value1); }
                    connection-busy: root.connection-busy;
                    reconnect-requested(value0) => { root.reconnect-requested(value0); }
                    history-device-name: root.history-device-name;
                    history-entries: root.history-entries;
                }
                if root.page == 4: SettingsPage {
                    settings-text: root.settings-text;
                    rtl: root.rtl;
                    device-name-text: root.device-name-text;
                    ready: root.ready;
                    preview-visible: root.preview-visible;
                    display-name <=> root.display-name;
                    save-display-name(value0) => { root.save-display-name(value0); }
                    save-text: root.save-text;
                    default-directory <=> root.default-directory;
                    choose-folder-text: root.choose-folder-text;
                    choose-directory() => { root.choose-directory(); }
                    theme-style <=> root.theme-style;
                    select-theme(value0) => { root.select-theme(value0); }
                    language-text: root.language-text;
                    english-text: root.english-text;
                    persian-text: root.persian-text;
                    selected-language <=> root.selected-language;
                    select-language(value0) => { root.select-language(value0); }
                    brightness <=> root.brightness;
                    save-brightness(value0) => { root.save-brightness(value0); }
                }
            }
        }
    }
    if !root.ready: Rectangle {
        z: 900;
        x: root.compact || root.rtl ? 0px : root.nav-width;
        width: root.compact ? root.width : root.width - root.nav-width;
        height: root.compact ? root.height - 80px : root.height;
        background: MaterialPalette.background;
        TouchArea {}
        VerticalLayout {
            padding: 40px; alignment: center; spacing: 16px;
            Title { text: root.error-message == "" ? (root.rtl ? "در حال راه‌اندازی" : "Starting ContinueHere") : (root.rtl ? "راه‌اندازی ناموفق بود" : "Unable to start ContinueHere"); rtl: root.rtl; }
            Label { text: root.error-message; rtl: root.rtl; }
            if root.error-message != "": Label { text: root.rtl ? "پس از رفع خطا، برنامه را دوباره اجرا کنید." : "Resolve the error and restart the application."; rtl: root.rtl; }
        }
    }
    if root.active-transition != 0: Rectangle {
        z: 1000;
        width: root.width; height: root.height; background: #b8000000;
        forward-focus: modal-focus;
        TouchArea {}
        modal-focus := FocusScope {
            width: parent.width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if root.active-transition == 1 { root.preview-action("close", 0); }
                    if root.active-transition == 2 { root.close-reconnect-requested(); }
                    if root.active-transition == 3 { root.dismiss-error-requested(); }
                    if root.active-transition == 4 { root.document-action("cancel", ""); }
                    return accept;
                }
                return reject;
            }
            if root.active-transition == 1: PreviewDialog {
                x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                preview-title: root.preview-title;
                rtl: root.rtl;
                close-text: root.close-text;
                preview-action(value0, value1) => { root.preview-action(value0, value1); }
                preview-error: root.preview-error;
                window-height: root.height;
                preview-zoom <=> root.preview-zoom;
                preview-image: root.preview-image;
                preview-video: root.preview-video;
                connected-device-menu: root.connected-device-menu;
                destination-index <=> root.destination-index;
                destination-device <=> root.destination-device;
                connected-device-ids: root.connected-device-ids;
                preview-duration: root.preview-duration;
                send-handoff(value0, value1, value2, value3) => { root.send-handoff(value0, value1, value2, value3); }
                preview-path: root.preview-path;
                preview-position: root.preview-position;
                preview-playing: root.preview-playing;
                preview-time: root.preview-time;
                preview-volume <=> root.preview-volume;
            }
            if root.active-transition == 2: ReconnectDialog {
                x: 16px; y: 24px; width: parent.width - 32px;
                height: parent.height - 48px;
                rtl: root.rtl;
                reconnect-endpoint <=> root.reconnect-endpoint;
                device-action(value0, value1, value2) => { root.device-action(value0, value1, value2); }
                reconnect-device <=> root.reconnect-device;
                close-reconnect-requested() => { root.close-reconnect-requested(); }
            }
            if root.active-transition == 3: ErrorDialog {
                x: 20px; y: max(20px, (parent.height - self.height) / 2);
                width: parent.width - 40px;
                height: min(parent.height - 40px, 280px);
                rtl: root.rtl;
                error-message <=> root.error-message;
                close-text: root.close-text;
                dismiss-error-requested() => { root.dismiss-error-requested(); }
            }
            if root.active-transition == 4: DocumentDialog {
                x: 20px; y: max(20px, (parent.height - self.height) / 2);
                width: parent.width - 40px;
                height: min(parent.height - 40px, 360px);
                rtl: root.rtl;
                close-text: root.close-text;
                document-action(value0, value1) => { root.document-action(value0, value1); }
                document-title: root.document-title;
                document-device-name: root.document-device-name;
                document-kind: root.document-kind;
                document-position-input <=> root.document-position-input;
            }
        }
    }
    Rectangle { z: 2000; width: root.width; height: root.height; background: #000000; opacity: 1 - clamp(root.brightness, 50, 100) / 100; }
}
