export struct DeviceRow {
    id: string,
    name: string,
    detail: string,
    endpoint: string,
    connected: bool,
}

export struct ContentRow {
    connected: bool,
    incoming: bool,
    id: string,
    title: string,
    detail: string,
    status: string,
    progress: float,
    active: bool,
    offered: bool,
    can-open: bool,
    retryable: bool,
    can-retry: bool,
    unread: bool,
}
