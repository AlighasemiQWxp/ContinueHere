import { Button } from "std-widgets.slint";

export component Title inherits Text {
    in property <bool> rtl;
    color: #edf0fa;
    font-size: 24px;
    font-weight: 700;
    horizontal-alignment: rtl ? right : left;
    wrap: word-wrap;
}

export component Label inherits Text {
    in property <bool> rtl;
    color: #b5b9c9;
    font-size: 14px;
    horizontal-alignment: rtl ? right : left;
    wrap: word-wrap;
}

export component Card inherits Rectangle {
    background: #171b25;
    border-color: #303442;
    border-width: 1px;
    border-radius: 16px;
}

export component Badge inherits Rectangle {
    in property <bool> shown;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background: #ffd16a;
    opacity: shown ? 1 : 0;
    animate opacity { duration: 150ms; }
    accessible-role: text;
    accessible-label: "New activity";
}

export component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> unread;
    callback selected();
    height: 46px;
    Button {
        width: parent.width;
        height: parent.height;
        text: root.label;
        enabled: root.enabled;
        checkable: true;
        checked: root.active;
        clicked => { root.selected(); }
    }
    Badge { x: parent.width - 14px; y: 4px; shown: root.unread; }
}
