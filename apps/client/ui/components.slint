import { FilledButton, MaterialPalette, Slider, TextField } from "@material";
import { AppTheme } from "theme.slint";

export component AppSlider inherits Slider {
    callback changed(float);
    value-changed(value) => { root.changed(value); }
}

export component AppTextField inherits TextField {
    min-height: 56px;
}

export component Button inherits FilledButton {
    enabled: true;
    min-height: 48px;
}

export component Title inherits Text {
    in property <bool> rtl;
    color: MaterialPalette.on-surface;
    font-size: 24px;
    font-weight: 700;
    horizontal-alignment: rtl ? right : left;
    vertical-alignment: center;
    wrap: char-wrap;
}

export component Label inherits Text {
    in property <bool> rtl;
    color: MaterialPalette.on-surface-variant;
    font-size: 14px;
    horizontal-alignment: rtl ? right : left;
    vertical-alignment: center;
    wrap: char-wrap;
}

export component Card inherits Rectangle {
    background: AppTheme.card;
    border-color: MaterialPalette.outline-variant;
    border-width: 1px;
    border-radius: 18px;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000028;
    drop-shadow-offset-y: 5px;
}

export component Badge inherits Rectangle {
    in property <bool> shown;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background: #ffd16a;
    opacity: shown ? 1 : 0;
    animate opacity { duration: 150ms; }
    accessible-role: text;
    accessible-label: "New activity";
}
