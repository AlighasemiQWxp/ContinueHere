import { Title, Label, Card, Button, SecondaryButton, QuietButton, AppTextField } from "../components.slint";
import { MaterialPalette } from "@material";

export component ReceivePage inherits VerticalLayout {
    in property <string> devices-text;
    in property <bool> rtl;
    in property <string> local-device-name;
    in property <string> local-device-detail;
    in property <string> pairing-status;
    in property <string> pairing-code;
    in property <bool> ready;
    in property <bool> preview-visible;
    in property <bool> pairing-active;
    in property <bool> pairing-verifiable;
    callback pairing-action(string, string);
    in property <string> reject-text;
    in property <string> cancel-text;
    in property <string> local-addresses;
    in property <string> pairing-endpoint;
    in property <string> transport-endpoint;
    in property <bool> network-available;
    in property <string> default-directory;
    callback refresh-network();
    property <bool> details-expanded: false;
    property <bool> receive-ready: root.ready && root.network-available && root.transport-endpoint != "";

    spacing: 12px;
    Title { text: root.devices-text; rtl: root.rtl; }
    Card {
        VerticalLayout {
            padding: 16px; spacing: 8px;
            Label { text: root.receive-ready ? (root.rtl ? "آماده دریافت" : "Ready to receive") : (root.rtl ? "دریافت در دسترس نیست" : "Receiving is unavailable"); rtl: root.rtl; color: root.receive-ready ? MaterialPalette.primary : MaterialPalette.error; }
            Title { text: root.local-device-name; rtl: root.rtl; font-size: 20px; }
            Label { text: root.receive-ready ? (root.rtl ? "این دستگاه را در صفحه ارسال دستگاه دیگر انتخاب کنید. درخواست‌های ورودی اینجا نمایش داده می‌شوند." : "Choose this device on the other device's Send screen. Incoming requests will appear here.") : (root.rtl ? "اتصال شبکه را بررسی کنید. برای بررسی نشانی‌ها، جزئیات اتصال را باز کنید." : "Check your network connection. Open Connection details to review the addresses."); rtl: root.rtl; }
            Label { text: root.rtl ? "فایل‌های پذیرفته‌شده در این پوشه ذخیره می‌شوند:" : "Accepted files are saved to:"; rtl: root.rtl; }
            Label { text: root.default-directory; }
        }
    }
    if root.pairing-active: Card {
        VerticalLayout {
            padding: 16px; spacing: 10px;
            Title { text: root.rtl ? "تأیید دستگاه" : "Verify your device"; rtl: root.rtl; font-size: 18px; }
            Label { text: root.pairing-status; rtl: root.rtl; }
            if root.pairing-code != "": AppTextField { enabled: root.ready && !root.preview-visible; text: root.pairing-code; read-only: true; horizontal-alignment: center; }
            if root.pairing-verifiable: Label { text: root.rtl ? "فقط اگر کدها در هر دو دستگاه یکسان هستند تأیید کنید." : "Approve only if both devices show the same code."; rtl: root.rtl; }
            VerticalLayout {
                spacing: 8px;
                Button { text: root.rtl ? "کدها یکسان‌اند" : "Codes match"; enabled: root.pairing-verifiable && root.ready && !root.preview-visible; clicked => { root.pairing-action("approve", ""); } }
                HorizontalLayout {
                    spacing: 8px;
                    SecondaryButton { text: root.reject-text; enabled: root.pairing-verifiable && root.ready && !root.preview-visible; clicked => { root.pairing-action("reject", ""); } }
                    QuietButton { text: root.cancel-text; enabled: root.ready && !root.preview-visible; clicked => { root.pairing-action("cancel", ""); } }
                }
            }
        }
    }
    QuietButton { text: root.rtl ? "جزئیات اتصال" : "Connection details"; enabled: root.ready && !root.preview-visible; clicked => { root.details-expanded = !root.details-expanded; } }
    if root.details-expanded: Card {
        VerticalLayout {
            padding: 14px; spacing: 8px;
            Label { text: root.local-device-detail; rtl: root.rtl; }
            Label { text: root.pairing-status; rtl: root.rtl; }
            Label { text: root.local-addresses; }
            Label { text: (root.rtl ? "درگاه جفت‌سازی: " : "Pairing port: ") + root.pairing-endpoint; rtl: root.rtl; }
            Label { text: (root.rtl ? "درگاه اتصال: " : "Connection port: ") + root.transport-endpoint; rtl: root.rtl; }
            SecondaryButton { text: root.rtl ? "تازه‌سازی نشانی‌ها" : "Refresh addresses"; enabled: root.ready && !root.preview-visible; clicked => { root.refresh-network(); } }
        }
    }
}
