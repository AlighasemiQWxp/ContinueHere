import { Title, Label, Card, Button, SecondaryButton, QuietButton, AppTextField } from "../components.slint";
import { MaterialPalette } from "@material";

export component ReceivePage inherits VerticalLayout {
    in property <string> devices-text;
    in property <bool> rtl;
    in property <string> local-device-name;
    in property <string> local-device-detail;
    in property <string> pairing-status;
    in property <string> pairing-code;
    in property <bool> ready;
    in property <bool> preview-visible;
    in property <bool> pairing-active;
    in property <bool> pairing-verifiable;
    callback pairing-action(string, string);
    in property <string> reject-text;
    in property <string> cancel-text;
    in property <string> local-addresses;
    in property <string> pairing-endpoint;
    in property <string> transport-endpoint;
    callback refresh-network();

    spacing: 16px;
    Title { text: root.devices-text; rtl: root.rtl; }
    Card {
        VerticalLayout {
            padding: 16px; spacing: 6px;
            Label { text: root.rtl ? "آماده دریافت" : "Ready to receive"; rtl: root.rtl; color: MaterialPalette.primary; }
            Title { text: root.local-device-name; rtl: root.rtl; font-size: 19px; }
            Label { text: root.local-device-detail; rtl: root.rtl; }
        }
    }
    Card {
        VerticalLayout {
            padding: 20px; spacing: 12px;
            Label { text: root.pairing-status; rtl: root.rtl; }
            if root.pairing-code != "": AppTextField { enabled: root.ready && !root.preview-visible; text: root.pairing-code; read-only: true; horizontal-alignment: center; }
            if root.pairing-active: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: root.rtl ? "تأیید" : "Approve"; enabled: (root.pairing-verifiable) && root.ready && !root.preview-visible; clicked => { root.pairing-action("approve", ""); } }
                    SecondaryButton { text: root.reject-text; enabled: (root.pairing-verifiable) && root.ready && !root.preview-visible; clicked => { root.pairing-action("reject", ""); } }
                    QuietButton { enabled: root.ready && !root.preview-visible; text: root.cancel-text; clicked => { root.pairing-action("cancel", ""); } }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 14px; spacing: 6px;
            Label { text: root.rtl ? "جزئیات اتصال" : "Connection details"; rtl: root.rtl; color: MaterialPalette.on-surface; }
            Label { text: root.local-addresses; horizontal-alignment: left; }
            Label { text: (root.rtl ? "درگاه جفت‌سازی: " : "Pairing listener: ") + root.pairing-endpoint; rtl: root.rtl; }
            Label { text: (root.rtl ? "درگاه اتصال: " : "Connection listener: ") + root.transport-endpoint; rtl: root.rtl; }
            SecondaryButton { text: root.rtl ? "تازه‌سازی نشانی‌ها" : "Refresh addresses"; clicked => { root.refresh-network(); } }
        }
    }
}
