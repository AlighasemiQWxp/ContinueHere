import { Title, Label, Card, Badge, Button, SecondaryButton, QuietButton } from "../components.slint";
import { MaterialPalette } from "@material";
import { ContentRow } from "../models.slint";
import { ActivityCard } from "activity.slint";

export component HistoryPage inherits VerticalLayout {
    in property <bool> rtl;
    in property <string> history-error;
    in-out property <string> history-device;
    in property <[ContentRow]> history-devices;
    in property <[ContentRow]> recent-history;
    in property <bool> ready;
    in property <bool> preview-visible;
    callback history-action(string, string);
    in property <bool> connection-busy;
    callback reconnect-requested(string);
    in property <string> history-device-name;
    in property <[ContentRow]> history-entries;
    property <bool> by-device: false;
    property <bool> confirm-clear: false;
    property <bool> interactive: root.ready && !root.preview-visible;

    spacing: 12px;
    Title { text: root.rtl ? "تاریخچه" : "History"; rtl: root.rtl; }
    if root.history-error != "": Label { text: root.history-error; rtl: root.rtl; color: MaterialPalette.error; }
    if root.history-device == "": VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            SecondaryButton { text: root.rtl ? "اخیر" : "Recent"; enabled: root.interactive && root.by-device; clicked => { root.by-device = false; } }
            SecondaryButton { text: root.rtl ? "بر اساس دستگاه" : "By device"; enabled: root.interactive && !root.by-device; clicked => { root.by-device = true; } }
        }
        if root.history-devices.length == 0: Label { text: root.rtl ? "فعالیت‌ها پس از اولین ارسال یا دریافت اینجا نمایش داده می‌شوند." : "Your activity will appear here after your first send or receive."; rtl: root.rtl; }
        if !root.by-device: VerticalLayout {
            spacing: 12px;
            for item in root.recent-history: ActivityCard {
                rtl: root.rtl; item: item;
                interactive: root.interactive;
                connection-busy: root.connection-busy;
                allow-remove: true;
                history-action(id, action) => { root.history-action(id, action); }
                reconnect-requested(id) => { root.reconnect-requested(id); }
            }
            if root.recent-history.length == 0 && root.history-devices.length > 0: Label { text: root.rtl ? "هنوز محتوایی ارسال نشده است. برای دیدن اتصال‌ها «بر اساس دستگاه» را انتخاب کنید." : "No content shared yet. Choose By device to view connection history."; rtl: root.rtl; }
            if root.recent-history.length == 50: Label { text: root.rtl ? "۵۰ مورد اخیر نمایش داده می‌شود. برای دیدن موارد قدیمی‌تر، یک دستگاه را انتخاب کنید." : "Showing the latest 50 items. Choose a device to see older activity."; rtl: root.rtl; }
        }
        if root.by-device: VerticalLayout {
            spacing: 12px;
            for item in root.history-devices: Card {
                VerticalLayout {
                    padding: 14px; spacing: 10px;
                    HorizontalLayout {
                        Label { text: item.title; rtl: root.rtl; color: MaterialPalette.on-surface; font-size: 18px; }
                        Badge { shown: item.unread; }
                    }
                    Label { text: item.detail; rtl: root.rtl; }
                    Button { text: root.rtl ? "مشاهده فعالیت‌ها" : "View activity"; enabled: root.interactive; clicked => { root.history-action(item.id, "device"); } }
                    if !item.connected: SecondaryButton { text: root.rtl ? "اتصال دوباره" : "Reconnect"; enabled: !root.connection-busy && root.interactive; clicked => { root.reconnect-requested(item.id); } }
                }
            }
        }
        if root.history-devices.length > 0: QuietButton { text: root.rtl ? "پاک کردن تاریخچه" : "Clear history"; enabled: root.interactive; clicked => { root.confirm-clear = true; } }
        if root.confirm-clear: Card {
            VerticalLayout {
                padding: 14px; spacing: 10px;
                Label { text: root.rtl ? "فعالیت‌های پایان‌یافته پاک شوند؟ فایل‌های دریافتی و دستگاه‌های جفت‌شده باقی می‌مانند." : "Clear finished activity? Received files and paired devices will be kept."; rtl: root.rtl; }
                HorizontalLayout {
                    spacing: 8px;
                    SecondaryButton { text: root.rtl ? "پاک کردن تاریخچه" : "Clear history"; enabled: root.interactive; clicked => { root.history-action("", "clear"); root.confirm-clear = false; } }
                    QuietButton { text: root.rtl ? "لغو" : "Cancel"; clicked => { root.confirm-clear = false; } }
                }
            }
        }
    }
    if root.history-device != "": VerticalLayout {
        spacing: 12px;
        QuietButton { text: root.rtl ? "بازگشت به دستگاه‌ها" : "Back to devices"; enabled: root.interactive; clicked => { root.history-action("", "back"); root.by-device = true; root.confirm-clear = false; } }
        Title { text: root.history-device-name; rtl: root.rtl; font-size: 20px; }
        if root.history-entries.length == 0: Label { text: root.rtl ? "فعالیتی وجود ندارد." : "No activity."; rtl: root.rtl; }
        for item in root.history-entries: ActivityCard {
            rtl: root.rtl; item: item;
            interactive: root.interactive;
            connection-busy: root.connection-busy;
            allow-remove: true;
            show-details: true;
            history-action(id, action) => { root.history-action(id, action); }
            reconnect-requested(id) => { root.reconnect-requested(id); }
        }
    }
}
