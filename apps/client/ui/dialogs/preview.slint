import { ScrollView } from "std-widgets.slint";
import { Label, Card, AppSlider } from "../components.slint";
import { TooltipSystem } from "../tooltip.slint";
import { MaterialPalette, DropDownMenu, MenuItem } from "@material";

export component PreviewDialog inherits Card {
    in property <string> preview-title;
    in property <bool> rtl;
    in property <string> close-text;
    callback preview-action(string, float);
    in property <string> preview-error;
    in property <length> window-height;
    in-out property <float> preview-zoom;
    in property <image> preview-image;
    in property <bool> preview-video;
    in property <[MenuItem]> connected-device-menu;
    in-out property <int> destination-index;
    in-out property <string> destination-device;
    in property <[string]> connected-device-ids;
    in property <float> preview-duration;
    callback send-handoff(string, string, string, string);
    in property <string> preview-path;
    in property <float> preview-position;
    in property <bool> preview-playing;
    in property <string> preview-time;
    in-out property <float> preview-volume;

    TouchArea {}
    ScrollView {
        width: 100%; height: 100%; viewport-width: self.width;
        VerticalLayout {
            padding: 16px; spacing: 12px;
            HorizontalLayout {
                Label { text: root.preview-title; rtl: root.rtl; color: MaterialPalette.on-surface; font-size: 18px; horizontal-stretch: 1; }
                TooltipSystem { icon: @image-url("../../assets/close.svg"); label: root.close-text; min-width: 48px; min-height: 48px; clicked => { root.preview-action("close", 0); } }
            }
            if root.preview-error != "": Label { text: root.preview-error; rtl: root.rtl; color: MaterialPalette.error; }
            viewer := ScrollView {
                height: max(120px, root.window-height * 0.45);
                viewport-width: self.width * root.preview-zoom;
                viewport-height: self.height * root.preview-zoom;
                Image { width: viewer.viewport-width; height: viewer.viewport-height; source: root.preview-image; image-fit: contain; }
            }
            if !root.preview-video: VerticalLayout {
                spacing: 8px;
                Label { text: root.rtl ? "بزرگ‌نمایی" : "Zoom"; rtl: root.rtl; }
                AppSlider { minimum: 1; maximum: 5; step: 0.1; value <=> root.preview-zoom; }
                TooltipSystem { icon: @image-url("../../assets/zoom.svg"); label: "1:1"; min-width: 48px; min-height: 48px; clicked => { root.preview-zoom = 1; } }
            }
            if root.preview-video: VerticalLayout {
                DropDownMenu { min-height: 48px; items: root.connected-device-menu; current-index <=> root.destination-index; selected(value) => { root.destination-device = root.connected-device-ids[self.current-index]; } }
                TooltipSystem { icon: @image-url("../../assets/send.svg"); label: root.rtl ? "ادامه در دستگاه مقصد" : "Continue on device"; enabled: root.destination-device != "" && root.preview-duration > 0; min-width: 48px; min-height: 48px; clicked => { root.send-handoff("current-video", root.destination-device, root.preview-path, ""); } }

                spacing: 8px;
                AppSlider { minimum: 0; maximum: max(1, root.preview-duration); value: root.preview-position; enabled: root.preview-duration > 0; changed(value) => { root.preview-action("seek", value); } }
                VerticalLayout {
                    spacing: 10px;
                    TooltipSystem { icon: root.preview-playing ? @image-url("../../assets/pause.svg") : @image-url("../../assets/play.svg"); label: root.preview-playing ? (root.rtl ? "مکث" : "Pause") : (root.rtl ? "پخش" : "Play"); min-width: 48px; min-height: 48px; clicked => { root.preview-action("pause", 0); } }
                    Label { text: root.preview-time; }
                    Label { text: root.rtl ? "صدا" : "Volume"; rtl: root.rtl; }
                    AppSlider { minimum: 0; maximum: 1; step: 0.01; value <=> root.preview-volume; changed(value) => { root.preview-action("volume", value); } }
                }
            }
        }
    }
}
