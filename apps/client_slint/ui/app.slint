import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct DeviceRow {
    name: string,
    detail: string,
    connected: bool,
}

component SectionTitle inherits Text {
    in property <bool> rtl;
    color: #f2f4ff;
    font-size: 22px;
    font-weight: 700;
    horizontal-alignment: rtl ? right : left;
}

component FieldLabel inherits Text {
    in property <bool> rtl;
    color: #aeb5ca;
    font-size: 14px;
    horizontal-alignment: rtl ? right : left;
}

component DeviceCard inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> state;
    in property <bool> rtl;
    background: #202536;
    border-color: #30384f;
    border-width: 1px;
    border-radius: 10px;
    height: 78px;

    VerticalLayout {
        padding: 14px;
        spacing: 5px;
        Text {
            text: root.name;
            color: #f5f6ff;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: root.rtl ? right : left;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.rtl: Text {
                text: root.state;
                color: #c9a84a;
                horizontal-alignment: right;
            }
            Text {
                text: root.detail;
                color: #969fb8;
                horizontal-alignment: root.rtl ? right : left;
                overflow: elide;
            }
            if !root.rtl: Text {
                text: root.state;
                color: #c9a84a;
                horizontal-alignment: right;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "ContinueHere";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 560px;
    background: #111522;

    in-out property <int> page: 0;
    in property <bool> rtl: false;
    in-out property <string> error-message;
    in property <string> local-device-name;
    in property <string> local-device-detail;
    in property <bool> discovery-active: false;
    in property <[DeviceRow]> nearby-devices;
    in property <[DeviceRow]> trusted-devices;
    in-out property <string> display-name;
    in-out property <string> default-directory;
    in-out property <int> selected-language: 0;

    in property <string> devices-text: "Devices";
    in property <string> settings-text: "Settings";
    in property <string> this-device-text: "This device";
    in property <string> nearby-devices-text: "Nearby devices";
    in property <string> trusted-devices-text: "Trusted devices";
    in property <string> no-nearby-devices-text: "No nearby devices found.";
    in property <string> no-trusted-devices-text: "No trusted devices yet.";
    in property <string> manual-endpoint-text: "Manual endpoint (host:port)";
    in property <string> add-text: "Add";
    in property <string> active-text: "Discovery active";
    in property <string> inactive-text: "Discovery unavailable";
    in property <string> connected-text: "Connected";
    in property <string> disconnected-text: "Disconnected";
    in property <string> device-name-text: "Device name";
    in property <string> received-files-folder-text: "Received files folder";
    in property <string> language-text: "Language";
    in property <string> english-text: "English";
    in property <string> persian-text: "Persian";
    in property <string> save-text: "Save";
    in property <string> dismiss-text: "Dismiss";

    callback add-manual-endpoint(string);
    callback save-display-name(string);
    callback save-directory(string);
    callback select-language(int);
    callback refresh-devices-requested();
    callback refresh-settings-requested();

    nav := Rectangle {
        x: root.rtl ? root.width - self.width : 0px;
        width: 210px;
        height: root.height;
        background: #181d2c;
        border-color: #2a3043;
        border-width: 1px;

        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            alignment: start;
            Text {
                text: "ContinueHere";
                color: #ffffff;
                font-size: 23px;
                font-weight: 700;
                horizontal-alignment: root.rtl ? right : left;
            }
            Rectangle { height: 18px; }
            Button {
                text: root.devices-text;
                checkable: true;
                checked: root.page == 0;
                clicked => { root.page = 0; }
            }
            Button {
                text: root.settings-text;
                checkable: true;
                checked: root.page == 1;
                clicked => { root.page = 1; }
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: "UI powered by Slint";
                color: #7f879e;
                font-size: 12px;
                horizontal-alignment: root.rtl ? right : left;
            }
        }
    }

    content := Rectangle {
        x: root.rtl ? 0px : nav.width;
        width: root.width - nav.width;
        height: root.height;
        background: #111522;

        if root.page == 0: ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: self.width;

            VerticalLayout {
                padding: 32px;
                spacing: 14px;
                SectionTitle { text: root.devices-text; rtl: root.rtl; }
                Rectangle {
                    height: 104px;
                    background: #202536;
                    border-color: #c9a84a;
                    border-width: 1px;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 5px;
                        FieldLabel { text: root.this-device-text; rtl: root.rtl; }
                        Text {
                            text: root.local-device-name;
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: root.rtl ? right : left;
                        }
                        Text {
                            text: root.local-device-detail;
                            color: #969fb8;
                            horizontal-alignment: root.rtl ? right : left;
                            overflow: elide;
                        }
                    }
                }
                FieldLabel {
                    text: root.discovery-active ? root.active-text : root.inactive-text;
                    rtl: root.rtl;
                    color: root.discovery-active ? #68d391 : #f59e8b;
                }
                FieldLabel { text: root.manual-endpoint-text; rtl: root.rtl; }
                HorizontalLayout {
                    spacing: 10px;
                    endpoint := LineEdit {
                        placeholder-text: "192.168.1.20:5200";
                        accepted(value) => { root.add-manual-endpoint(value); }
                    }
                    Button {
                        text: root.add-text;
                        clicked => { root.add-manual-endpoint(endpoint.text); }
                    }
                }
                Rectangle { height: 8px; }
                SectionTitle { text: root.nearby-devices-text; rtl: root.rtl; }
                if root.nearby-devices.length == 0: FieldLabel {
                    text: root.no-nearby-devices-text;
                    rtl: root.rtl;
                }
                for device in root.nearby-devices: DeviceCard {
                    name: device.name;
                    detail: device.detail;
                    state: "";
                    rtl: root.rtl;
                }
                Rectangle { height: 8px; }
                SectionTitle { text: root.trusted-devices-text; rtl: root.rtl; }
                if root.trusted-devices.length == 0: FieldLabel {
                    text: root.no-trusted-devices-text;
                    rtl: root.rtl;
                }
                for device in root.trusted-devices: DeviceCard {
                    name: device.name;
                    detail: device.detail;
                    state: device.connected ? root.connected-text : root.disconnected-text;
                    rtl: root.rtl;
                }
            }
        }

        if root.page == 1: ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: self.width;

            VerticalLayout {
                padding: 32px;
                spacing: 12px;
                SectionTitle { text: root.settings-text; rtl: root.rtl; }
                Rectangle { height: 8px; }
                FieldLabel { text: root.device-name-text; rtl: root.rtl; }
                name-field := LineEdit {
                    text <=> root.display-name;
                    horizontal-alignment: root.rtl ? right : left;
                    accepted(value) => { root.save-display-name(value); }
                }
                Button {
                    text: root.save-text;
                    clicked => { root.save-display-name(name-field.text); }
                }
                Rectangle { height: 18px; }
                FieldLabel { text: root.received-files-folder-text; rtl: root.rtl; }
                directory-field := LineEdit {
                    text <=> root.default-directory;
                    horizontal-alignment: root.rtl ? right : left;
                    accepted(value) => { root.save-directory(value); }
                }
                Button {
                    text: root.save-text;
                    clicked => { root.save-directory(directory-field.text); }
                }
                Rectangle { height: 18px; }
                FieldLabel { text: root.language-text; rtl: root.rtl; }
                HorizontalLayout {
                    spacing: 10px;
                    if root.rtl: Button {
                        text: root.persian-text;
                        checkable: true;
                        checked: root.selected-language == 1;
                        clicked => { root.select-language(1); }
                    }
                    Button {
                        text: root.english-text;
                        checkable: true;
                        checked: root.selected-language == 0;
                        clicked => { root.select-language(0); }
                    }
                    if !root.rtl: Button {
                        text: root.persian-text;
                        checkable: true;
                        checked: root.selected-language == 1;
                        clicked => { root.select-language(1); }
                    }
                }
            }
        }
    }

    if root.error-message != "": Rectangle {
        x: 28px;
        y: root.height - 92px;
        width: root.width - 56px;
        height: 64px;
        background: #5a2430;
        border-color: #f59e8b;
        border-width: 1px;
        border-radius: 10px;
        HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            Text {
                text: root.error-message;
                color: #ffffff;
                wrap: word-wrap;
                horizontal-alignment: root.rtl ? right : left;
            }
            Button {
                text: root.dismiss-text;
                clicked => { root.error-message = ""; }
            }
        }
    }
}
